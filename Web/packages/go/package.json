{
  "name": "worker-typescript-template",
  "version": "1.0.0",
  "description": "Cloudflare worker TypeScript template",
  "main": "dist/worker.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --sourcemap --outfile=dist/worker.js",
    "typecheck": "tsc --noEmit"
  },
  "author": "author",
  "license": "MIT OR Apache-2.0",
  "eslintConfig": {
    "root": true,
    "extends": [
      "typescript",
      "prettier"
    ]
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^2.2.2",
    "typescript": "^7.0.2",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "accept-language": "^3.0.18"
  }
}
